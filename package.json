{
  "name": "swagger-builder",
  "version": "2.2.1",
  "description": "build swagger to javascript with axios",
  "author": "kaisawind <wind.kaisa@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/unit/",
    "test:integration": "node ./test/test.js",
    "test:all": "node --test test/unit/ && node ./test/test.js",
    "babel": "babel ./example/dist/yaml_apis.js > ./test/apis.js",
    "lint": "eslint --ext .js .",
    "test-yaml": "./bin/swagger-builder.js -f=./example/swagger/swagger.yaml -o=./example/dist/yaml_apis.js",
    "test-json": "./bin/swagger-builder.js -f=./example/swagger/swagger.json -o=./example/dist/json_apis.js"
  },
  "keywords": [
    "swagger",
    "parser",
    "axios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisawind/swagger-builder.git"
  },
  "bugs": {
    "url": "https://github.com/kaisawind/swagger-builder/issues"
  },
  "bin": "bin/swagger-builder.js",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "argparse": "^2.0.1",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "axios": "^1.17.0",
    "core-js": "^3.49.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": ">= 8.0.0",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "modules": false,
          "targets": {
            "edge": "17",
            "firefox": "60",
            "chrome": "67",
            "safari": "11.1"
          },
          "useBuiltIns": "usage",
          "corejs": "3.6.5"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.6.0"
}
